[appindicator]
icon-brightness=0.0
icon-contrast=0.0
icon-opacity=240
icon-saturation=0.0
icon-size=0

[arcmenu]
custom-menu-button-icon='dota2'
custom-menu-button-icon-size=20.0
distro-icon=2
menu-button-icon='dota2'
pinned-apps=[{'id': 'firefox.desktop'}, {'id': 'org.gnome.Nautilus.desktop'}, {'id': 'org.gnome.Terminal.desktop'}, {'id': 'gnome-extensions prefs arcmenu@arcmenu.com', 'name': 'ArcMenu Settings', 'icon': 'ArcMenu_ArcMenuIcon'}, {'id': 'com.mattjakeman.ExtensionManager.desktop'}, {'id': 'org.gnome.Extensions.desktop'}, {'id': 'com.brave.Browser.desktop'}, {'id': 'evolve.desktop'}, {'id': 'Alacritty.desktop'}, {'id': 'com.cisco.secureclient.gui.desktop'}, {'id': 'com.spotify.Client.desktop'}]
search-entry-border-radius=(true, 25)
show-activities-button=true

[blur-my-shell]
pipelines={'pipeline_default': {'name': <'Default'>, 'effects': <[<{'type': <'dual_kawase_blur'>, 'id': <'effect_000000000000'>, 'params': <{'unscaled_radius': <30>, 'brightness': <0.59999999999999998>}>}>]>}, 'pipeline_migrated_dynamic_blur': {'name': <'Migrated dynamic blur'>, 'effects': <[<{'type': <'dual_kawase_blur'>, 'id': <'effect_migrated_dynamic_blur'>, 'params': <{'unscaled_radius': <100>, 'brightness': <0.59999999999999998>}>}>]>}, 'pipeline_migrated_dynamic_blur_2': {'name': <'Migrated dynamic blur 2'>, 'effects': <[<{'type': <'dual_kawase_blur'>, 'id': <'effect_migrated_dynamic_blur'>, 'params': <{'unscaled_radius': <26>, 'brightness': <0.59999999999999998>}>}>]>}, 'pipeline_migrated_dynamic_blur_3': {'name': <'Migrated dynamic blur 3'>, 'effects': <[<{'type': <'dual_kawase_blur'>, 'id': <'effect_migrated_dynamic_blur'>, 'params': <{'unscaled_radius': <60>, 'brightness': <0.59999999999999998>}>}>]>}}
rounded-blur-found=false
settings-version=7

[blur-my-shell/appfolder]
pipeline='pipeline_migrated_dynamic_blur'

[blur-my-shell/applications]
blur=true
dynamic-opacity=true
opacity=220
pipeline='pipeline_migrated_dynamic_blur_2'

[blur-my-shell/coverflow-alt-tab]
pipeline='pipeline_default'

[blur-my-shell/dash-to-dock]
blur=false
pipeline='pipeline_default'
static-blur=true
style-dash-to-dock=0

[blur-my-shell/dash-to-panel]
blur-original-panel=false

[blur-my-shell/lockscreen]
pipeline='pipeline_default'

[blur-my-shell/overview]
pipeline='pipeline_default'
style-components=2

[blur-my-shell/panel]
pipeline='pipeline_default'
static-blur=true
unblur-in-overview=false

[blur-my-shell/popup]
blur=true
pipeline='pipeline_default'
preserve-shell-theme=true

[blur-my-shell/screenshot]
pipeline='pipeline_default'

[blur-my-shell/window-list]
pipeline='pipeline_migrated_dynamic_blur_3'

[caffeine]
cli-toggle=true
countdown-timer=0
duration-timer=0
duration-timer-list=[300, 600, 1800]
indicator-position-max=3
show-indicator='always'

[clipboard-indicator]
display-mode=0
next-history-clear=-1
preview-size=30

[just-perfection]
accessibility-menu=true
activities-button=true
clock-menu=true
dash=false
dash-app-running=true
dash-icon-size=0
dash-separator=true
keyboard-layout=true
panel=true
panel-in-overview=true
quick-settings=true
quick-settings-dark-mode=true
quick-settings-night-light=true
ripple-box=true
search=true
show-apps-button=true
startup-status=1
support-notifier-type=0
theme=false
window-demands-attention-focus=false
window-menu=true
window-picker-icon=true
window-preview-caption=true
window-preview-close-button=true
workspace=true
workspace-popup=true
workspaces-in-app-grid=true

[media-controller]
card-art-backdrop=true
card-art-size='small'
card-show-art=true
card-width=430
controls-on-left=false
hide-when-inactive=true
lyrics-height=160
lyrics-online-lookup=true
panel-position='left'
panel-text-width=230
pause-others-on-play=false
scroll-text=false
show-loop=false
show-seek-backward=false
show-shuffle=false

[pop-shell]
active-hint=false
focus-left=['<Super>Left']
focus-right=['<Super>Right']
hint-color-rgba='rgb(131,165,152)'
mouse-cursor-focus-location=uint32 4
pop-monitor-left=@as []
pop-monitor-right=@as []
pop-workspace-down=['<Shift><Super>Down']
pop-workspace-up=['<Shift><Super>Up']
show-title=true
tile-by-default=true

[rounded-window-corners-reborn]
border-width=0
settings-version=uint32 9

[user-theme]
name='Gruvbox-Dark-Medium'
